# I Fix Everything — environment configuration.
# Copy to .env.local for local development, or run `pnpm env:local` after
# `pnpm db:start` to fill the local Supabase values automatically.
# Never commit real credentials. Production secrets belong in your hosting
# provider's secret manager (see docs/deployment.md), not in this file.

# development | staging | production
APP_ENV=development

# --- Supabase (Auth, Storage, Postgres) -------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
SUPABASE_URL=
# Publishable (anon) key. Safe to ship in clients; RLS + the API enforce access.
SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key. SERVER ONLY — web API and worker. Never in a client.
SUPABASE_SECRET_KEY=
# Postgres connection string used by the API and worker (direct or session pooler).
DATABASE_URL=
# Optional: expected JWT issuer (defaults to $SUPABASE_URL/auth/v1)
AUTH_JWT_ISSUER=
# Private bucket for case media
MEDIA_BUCKET=case-media

# --- Web ---------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:3000
# Browser-visible copies (Next.js inlines NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Native (Expo inlines EXPO_PUBLIC_* at build time) ----------------------
# Base URL of the web/API server as reachable from the device or simulator.
# Android emulator: http://10.0.2.2:3000, iOS simulator: http://127.0.0.1:3000,
# physical device: your machine's LAN IP or a staging HTTPS URL.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Client version policy (installed native apps below these get "update required")
MIN_CLIENT_VERSION_WEB=0.1.0
MIN_CLIENT_VERSION_IOS=0.1.0
MIN_CLIENT_VERSION_ANDROID=0.1.0

# --- Development only --------------------------------------------------------
# Labeled synthetic sample content. Refused at startup unless APP_ENV=development.
DEMO_MODE=false

# --- Later milestones (leave empty until the milestone and approval) -------
# Milestone 3: inference provider (consumer AI requests; separate from Claude Code)
ANTHROPIC_API_KEY=
# Milestone 4: YouTube Data API key
YOUTUBE_API_KEY=
# Milestone 5: sandbox billing (test mode only until launch approval)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
